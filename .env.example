# Northscore Stats API key (server-side only — never expose to clients)
NORTHSCORE_STATS_API_KEY=your_api_key_here

# Northscore API base URL
# Local development: http://localhost:8080/api/v1
# Production (Railway private networking): http://<service>.railway.internal/api/v1
NORTHSCORE_API_BASE_URL=http://localhost:8080/api/v1

# Transport: stdio (local clients like Claude Desktop) or http (Streamable HTTP for remote hosts)
MCP_TRANSPORT=stdio

# HTTP transport bind address (use 0.0.0.0 when hosted, e.g. Railway)
HOST=127.0.0.1

# HTTP transport port (optional, defaults to 3002)
PORT=3002

# Node environment (optional, defaults to development)
NODE_ENV=development

# Log level: debug | info | warn | error (optional, defaults to info)
# Logs are structured JSON on stderr — Claude Desktop captures them in
# ~/Library/Logs/Claude/mcp-server-northscore.log
LOG_LEVEL=info

# Supabase JWT secret (for HTTP transport authentication)
# Required when MCP_TRANSPORT=http. Get this from your Supabase project:
# Settings → API → JWT Secret (the unsigned secret for HS256 validation)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
